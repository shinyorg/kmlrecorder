<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shiny="http://shiny.net/maui/controls"
             xmlns:local="clr-namespace:ShinyKmlRecorder"
             x:DataType="local:ObdParametersViewModel"
             x:Class="ShinyKmlRecorder.ObdParametersPage"
             Title="OBD Parameters">

    <shiny:TableView>
        <shiny:TableRoot>

            <shiny:TableSection Title="Polling"
                                FooterText="How often the selected parameters are read. Each parameter is a separate request, so many parameters on a slow adapter can stretch the real interval.">
                <shiny:NumberPickerCell Title="Poll Interval"
                                        Number="{Binding PollIntervalSeconds, Mode=TwoWay}"
                                        Min="1"
                                        Max="300"
                                        Unit="s" />
            </shiny:TableSection>

            <shiny:TableSection Title="Parameters"
                                FooterText="Parameters the vehicle does not support are skipped while recording. Support is shown once an adapter is connected."
                                ItemsSource="{Binding Parameters}">
                <shiny:TableSection.ItemTemplate>
                    <DataTemplate x:DataType="local:ObdParameterItem">
                        <shiny:SwitchCell Title="{Binding Name}"
                                          Description="{Binding Description}"
                                          On="{Binding IsSelected, Mode=TwoWay}" />
                    </DataTemplate>
                </shiny:TableSection.ItemTemplate>
            </shiny:TableSection>

            <shiny:TableSection Title="Actions">
                <shiny:ButtonCell Title="Reset to Defaults"
                                  Command="{Binding ResetDefaultsCommand}"
                                  ButtonTextColor="Red" />
            </shiny:TableSection>

        </shiny:TableRoot>
    </shiny:TableView>
</ContentPage>
